# Copy to .env beside compose.yaml. This configures Compose, not the applications.
# Assisted setup writes the required keys automatically:
# bash scripts/pulso-docker.sh install
PULSO_IMAGE=ghcr.io/josehbernardino/pulso:latest
PULSO_BIND=0.0.0.0
PULSO_PORT=5011
PULSO_APPS_DIR=./applications

# You may set an absolute parent folder containing all your projects, for example:
# PULSO_APPS_DIR=/ctmagent/develop/Servicos
# All subfolders then appear under /apps. No volume per application is needed.
# Optional explicit aliases for extra volumes (mount them in a Compose override too):
# PULSO_PATH_MAPPINGS='[{"host":"/srv/extra","container":"/extra"}]'

# Full host access (trusted administrators only). Compose >=2.24.4.
# The host filesystem is mounted at /host without SELinux z/Z relabeling.
# COMPOSE_FILE=compose.yaml:compose.host.yaml
# Local build alternative:
# COMPOSE_FILE=compose.yaml:compose.build.yaml:compose.host.yaml

# Optional local build with exact Python 3.11 (requires compose.build.yaml):
# PULSO_BUILD_TARGET=runtime-python311

# Portal updates require a published image and compose.update.yaml LAST in COMPOSE_FILE.
# COMPOSE_FILE=compose.yaml:compose.host.yaml:compose.update.yaml
# PULSO_IMAGE=ghcr.io/josehbernardino/pulso:latest-python311
# PULSO_UPDATE_IMAGE=ghcr.io/josehbernardino/pulso
# PULSO_RELEASE_REPOSITORY=joseHbernardino/pulso
# For rootless Docker, point to the daemon's actual socket:
# PULSO_DOCKER_SOCKET=/run/user/1000/docker.sock
# Optional identity for local builds (compose.build.yaml):
# PULSO_BUILD_VERSION=dev
# PULSO_BUILD_REVISION=<git commit>
# PULSO_BUILD_TIME=<UTC timestamp>
